APP_DOMAIN="app.example.com"
DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase" # Replace with your actual database URL

BETTER_AUTH_SECRET="supersecretkey" # Replace with a strong secret key
BETTER_AUTH_URL="http://localhost:3000" # Base URL of your app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GEMINI_API_KEY="" # Google AI Studio key; the OpenAI SDK calls Gemini's OpenAI-compatible endpoint
REVIEW_MODEL="gemini-3.1-flash-lite" # Model used for reviews (empty = this default)
CHUNK_TOKEN_BUDGET="7000" # Max estimated diff tokens per model call; bigger PRs are split into chunks
MAX_COMMENTS="15" # Max comments kept per review after merging, most severe first
CONTEXT_TOKEN_BUDGET="4000" # Max estimated tokens of repo context (full file, signatures, call sites) per chunk
JUDGE_MODEL="gemini-3-flash-preview" # Evals only: grades whether a comment identifies the planted bug
JUDGE_API_KEY="" # Evals only, optional: a key from another Google project so judging has its own free-tier quota (empty = GEMINI_API_KEY)
LOG_LEVEL="info" # debug | info | warn | error. Raw model output is only logged at debug

GITHUB_WEBHOOK_SECRET="supersecretwebhooksecret" # Replace with a strong secret key

EVAL_E2E_DATABASE_URL="" # Sandbox app DB for GitHub E2E polling; never point this at production

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Benchmark-only. Use a disposable database and a dedicated test repository.
BENCH_DATABASE_URL="postgresql://user:password@localhost:5432/aicodereviewer_bench"
TESTBED_REPO="owner/testprrepo"
GITHUB_TOKEN=""
BENCH_CONFIRM_ISOLATED_DB="I_ACKNOWLEDGE_THIS_IS_AN_ISOLATED_TEST_DATABASE"
BENCH_REVIEW_TIMEOUT_MS="600000"
BENCH_REQUEST_GAP_MS="1500"
BENCH_FORCE_RETRY_PR_NUMBER=""
BENCH_ENABLE_RETRY_TEST="false"
