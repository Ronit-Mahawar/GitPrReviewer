+/** True if the named feature flag is on. Flags live in the database so they can change without a deploy. */
+export async function isFeatureEnabled(name: string): Promise<boolean> {
+  const rows = await query<{ enabled: boolean }>("SELECT enabled FROM feature_flags WHERE name = $1", [name]);
+  return rows[0]?.enabled ?? false;
