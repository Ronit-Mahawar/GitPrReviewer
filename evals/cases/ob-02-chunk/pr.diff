+++ b/src/utils.ts
@@ -1,3 +1,11 @@
 export function sleep(ms: number): Promise<void> {
   return new Promise((resolve) => setTimeout(resolve, ms));
 }
+
+export function chunk<T>(items: T[], size: number): T[][] {
+  const out: T[][] = [];
+  for (let i = 0; i <= items.length; i += size) {
+    out.push(items.slice(i, i + size));
+  }
+  return out;
+}
