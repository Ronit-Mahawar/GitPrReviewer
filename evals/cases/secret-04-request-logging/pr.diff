@@ -0,0 +1,11 @@
+import type { Next, Req, Res } from "../http";
+import { logger } from "../logger";
+
+export function requestLogger(req: Req, _res: Res, next: Next) {
+  const started = Date.now();
+  logger.info(
+    `${req.method} ${req.path} auth=${req.headers.authorization ?? "-"} body=${JSON.stringify(req.body ?? {})}`,
+  );
+  next();
+  logger.info(`${req.method} ${req.path} done in ${Date.now() - started}ms`);
+}
