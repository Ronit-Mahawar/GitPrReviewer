--- /dev/null
+++ b/src/routes/reports.ts
@@ -0,0 +1,46 @@
+import type { Req, Res } from "../http";
+import { findUserById } from "../users";
+import { isReportName } from "../reports";
+import { activeUsersReport } from "../reports/active-users";
+import { averageBasketReport } from "../reports/average-basket";
+import { lowInventoryReport } from "../reports/inventory-low";
+import { orderStatusReport } from "../reports/order-status";
+import { refundsReport } from "../reports/refunds";
+import { revenueByMonthReport } from "../reports/revenue-by-month";
+import { salesByDayReport } from "../reports/sales-by-day";
+import { salesBySkuReport } from "../reports/sales-by-sku";
+import { signupsReport } from "../reports/signups";
+import { topCustomersReport } from "../reports/top-customers";
+import { walletUsageReport } from "../reports/wallet-usage";
+
+/** GET /reports/:name?from=&to=&year=&limit= — admin only. */
+export async function reportHandler(req: Req, res: Res) {
+  if (!req.userId) return res.status(401).json({ error: "unauthorized" });
+  const requester = await findUserById(req.userId);
+  if (!requester || requester.role !== "admin") return res.status(403).json({ error: "forbidden" });
+
+  const name = req.params.name;
+  if (!isReportName(name)) return res.status(404).json({ error: "unknown report" });
+
+  const range = { from: req.query.from ?? "", to: req.query.to ?? "" };
+  const limit = Math.min(Math.max(Number(req.query.limit ?? 20) || 20, 1), 500);
+
+  try {
+    switch (name) {
+      case "active-users": return res.json(await activeUsersReport(range));
+      case "average-basket": return res.json(await averageBasketReport(range));
+      case "inventory-low": return res.json(await lowInventoryReport(limit));
+      case "order-status": return res.json(await orderStatusReport(range));
+      case "refunds": return res.json(await refundsReport(range));
+      case "revenue-by-month": return res.json(await revenueByMonthReport(Number(req.query.year)));
+      case "sales-by-day": return res.json(await salesByDayReport(range));
+      case "sales-by-sku": return res.json(await salesBySkuReport(range, limit));
+      case "signups": return res.json(await signupsReport(range));
+      case "top-customers": return res.json(await topCustomersReport(range, limit));
+      case "wallet-usage": return res.json(await walletUsageReport(range));
+    }
+  } catch (err) {
+    if (err instanceof RangeError) return res.status(400).json({ error: err.message });
+    throw err;
+  }
+}
