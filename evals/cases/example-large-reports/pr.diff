new file mode 100644
index 0000000..956ccb8
--- /dev/null
+++ b/src/reports/revenue-by-month.ts
@@ -0,0 +1,37 @@
+import { query } from "../db";
+import type { ReportResult } from "./types";
+import { toCsv } from "./types";
+
+export interface RevenueByMonthRow {
+  month: string; // "2026-01"
+  cents: number;
+}
+
+/** Paid revenue for each month of a calendar year; months with no sales are 0. */
+export async function revenueByMonthReport(year: number): Promise<ReportResult<RevenueByMonthRow>> {
+  if (!Number.isInteger(year) || year < 2000 || year > 2100) throw new RangeError("year out of range");
+
+  const found = await query<{ month: string; cents: number }>(
+    "SELECT to_char(created_at, 'YYYY-MM') AS month, SUM(total_cents) AS cents FROM orders " +
+      "WHERE status = 'paid' AND created_at >= make_date($1, 1, 1) AND created_at < make_date($1 + 1, 1, 1) " +
+      "GROUP BY month",
+    [year],
+  );
+  const byMonth = new Map(found.map((row) => [row.month, Number(row.cents)]));
+
+  const rows: RevenueByMonthRow[] = [];
+  for (let month = 1; month <= 13; month++) {
+    const key = `${year}-${String(month).padStart(2, "0")}`;
+    rows.push({ month: key, cents: byMonth.get(key) ?? 0 });
+  }
+
+  return {
+    title: `Revenue by month, ${year}`,
+    rows,
+    totals: { cents: rows.reduce((sum, row) => sum + row.cents, 0) },
+  };
+}
+
+export function revenueByMonthCsv(result: ReportResult<RevenueByMonthRow>): string {
+  return toCsv(["month", "cents"], result.rows.map((row) => [row.month, row.cents]));
+}
