+import { activeUsersReport } from "./active-users";
+import { averageBasketReport } from "./average-basket";
+import { lowInventoryReport } from "./inventory-low";
+import { orderStatusReport } from "./order-status";
+import { refundsReport } from "./refunds";
+import { salesByDayReport } from "./sales-by-day";
+import { salesBySkuReport } from "./sales-by-sku";
+import { signupsReport } from "./signups";
+import { topCustomersReport } from "./top-customers";
+import { walletUsageReport } from "./wallet-usage";
+import { revenueByMonthReport } from "./revenue-by-month";
+
+/** Every report, by the name used in GET /reports/:name. */
+export const reports = {
+  "active-users": activeUsersReport,
+  "average-basket": averageBasketReport,
+  "inventory-low": lowInventoryReport,
+  "order-status": orderStatusReport,
+  "refunds": refundsReport,
+  "sales-by-day": salesByDayReport,
+  "sales-by-sku": salesBySkuReport,
+  "signups": signupsReport,
+  "top-customers": topCustomersReport,
+  "wallet-usage": walletUsageReport,
+  "revenue-by-month": revenueByMonthReport,
+} as const;
+
+export type ReportName = keyof typeof reports;
+
+export function isReportName(name: string): name is ReportName {
+  return Object.prototype.hasOwnProperty.call(reports, name);
+}
